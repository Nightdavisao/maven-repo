  <modelVersion>4.0.0</modelVersion>
  <groupId>dev.zt64.subsonic</groupId>
  <artifactId>subsonic-api-js</artifactId>
  <version>1.0.0-beta08</version>
  <packaging>klib</packaging>
  <name>subsonic-kotlin</name>
  <description>Kotlin Multiplatform library for the Subsonic API</description>
  <url>https://github.com/zt64/subsonic-kotlin</url>
  <inceptionYear>2026</inceptionYear>
  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>zt64</id>
      <name>zt64</name>
      <url>https://zt64.dev</url>
    </developer>
  </developers>
  <scm>
    <connection>scm:git:github.com/zt64/subsonic-kotlin.git</connection>
    <developerConnection>scm:git:ssh://github.com/zt64/subsonic-kotlin.git</developerConnection>
    <url>https://github.com/zt64/subsonic-kotlin</url>
  </scm>
  <dependencies>
    <dependency>
      <groupId>org.jetbrains.kotlin</groupId>
      <artifactId>kotlin-dom-api-compat</artifactId>
      <version>2.4.20</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>org.jetbrains.kotlin</groupId>
      <artifactId>kotlin-stdlib-js</artifactId>
      <version>2.4.20</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>org.jetbrains.kotlinx</groupId>
      <artifactId>kotlinx-serialization-json-js</artifactId>
      <version>1.11.0</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.jetbrains.kotlinx</groupId>
      <artifactId>kotlinx-datetime-js</artifactId>
      <version>0.8.0</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.kotlincrypto.hash</groupId>
      <artifactId>md-js</artifactId>
      <version>0.8.0</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.ktor</groupId>
      <artifactId>ktor-client-core-js</artifactId>
      <version>3.5.2</version>
      <scope>runtime</scope>
    </dependency>
